<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/os_900"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/os_900"
                android:textColor="@color/os_0"
                android:text="ACTIVE"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Card 1: Connection & Transport Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/os_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/os_100"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transport &amp; Network"
                    android:textColor="@color/os_900"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvActiveRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected via USB ADB Tunnel (Port 8765/8766)"
                    android:textColor="@color/os_900"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTargetEndpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 127.0.0.1:8765 (Mac) | Server: 0.0.0.0:8766"
                    android:textColor="@color/os_400"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvThroughput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed: 31+ MB/s (Offline USB-C) | Latency: &lt;1ms"
                    android:textColor="@color/os_400"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Send to Mac (File Picker & Quick Text Scratchpad) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/os_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/os_100"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_send_card_title"
                    android:textColor="@color/os_900"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="12dp" />

                <!-- 1. Big Obvious "Send Files to Mac" Button -->
                <Button
                    android:id="@+id/btnSendFilesToMac"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/action_send_to_mac"
                    android:textColor="@color/os_0"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="@color/os_900"
                    app:icon="@drawable/ic_mac_tray"
                    app:iconTint="@color/os_0"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:cornerRadius="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_select_files_sub"
                    android:textColor="@color/os_400"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/os_100"
                    android:layout_marginBottom="14dp" />

                <!-- 2. Text Input Scratchpad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEAM TEXT OR PROMPT"
                    android:textColor="@color/os_400"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etQuickText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:maxLines="5"
                    android:gravity="top|start"
                    android:hint="@string/quick_text_hint"
                    android:textColorHint="@color/os_300"
                    android:textColor="@color/os_900"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_pill_container"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPasteClipboard"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/action_paste"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/os_900"
                        android:backgroundTint="@color/os_0"
                        app:strokeColor="@color/os_100"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnClearText"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Clear"
                        android:textSize="12sp"
                        android:textColor="@color/os_400"
                        android:backgroundTint="@color/os_50"
                        app:strokeColor="@color/os_100"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSendText"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/action_send_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/os_0"
                        android:backgroundTint="@color/os_900"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBeamClipboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/action_beam_clipboard"
                android:textColor="@color/os_0"
                android:backgroundTint="@color/os_900"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnOpenStorage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/action_open_downloads"
                android:textColor="@color/os_900"
                android:backgroundTint="@color/os_50"
                app:strokeColor="@color/os_100"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Card 2: Features & Integration Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/os_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/os_100"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sol:OS Integrations"
                    android:textColor="@color/os_900"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Auto Screenshot Sync: Active (/sdcard/Pictures/Screenshots)"
                    android:textColor="@color/os_900"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Quick Settings Tile: 1-Tap Drop via Translucent Trampoline"
                    android:textColor="@color/os_900"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Direct Share Target: Registered (Rank 1 Chooser Sheet)"
                    android:textColor="@color/os_900"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Storage Target: /sdcard/Download/DaylightDrop/"
                    android:textColor="@color/os_400"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Recent Transfers & Code Block Shelf -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/os_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/os_100"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pasted / Received Text Code Block Section -->
                <LinearLayout
                    android:id="@+id/layoutCodeBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RECEIVED TEXT / SCRATCHPAD"
                            android:textColor="@color/os_400"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <Button
                            android:id="@+id/btnCopyCode"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Copy"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/os_0"
                            android:backgroundTint="@color/os_900"
                            app:cornerRadius="6dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCodeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/os_150"
                        android:textColor="@color/os_900"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:padding="10dp"
                        android:textIsSelectable="true"
                        android:maxLines="8"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transfer Streams"
                        android:textColor="@color/os_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Two-Sided Tab Pill Switcher -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_pill_container"
                        android:padding="2dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnTabReceived"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="From Mac"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/os_0"
                            android:backgroundTint="@color/os_900"
                            app:cornerRadius="6dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <Button
                            android:id="@+id/btnTabSent"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:text="To Mac"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/os_800"
                            android:backgroundTint="@color/os_150"
                            app:cornerRadius="6dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dynamic Clickable Files Container -->
                <LinearLayout
                    android:id="@+id/layoutRecentFilesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvRecentItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No transfers recorded yet."
                    android:textColor="@color/os_400"
                    android:textSize="13sp"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hardware & Display Profile Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daylight Computer (DC1) — Sol:OS"
                android:textColor="@color/os_400"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sharp NT36523N LivePaper LCD • 60–120Hz Fluid Refresh • Zero EPD Waveforms"
                android:textColor="@color/os_400"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
